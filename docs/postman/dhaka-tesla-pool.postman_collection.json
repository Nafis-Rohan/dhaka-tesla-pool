{
  "info": {
    "name": "Dhaka Tesla Pool API",
    "description": "Local API collection. No environment needed: every variable (baseUrl, token, rideId, zone ids) lives in the collection itself.\n\nOrder to try: 1) Auth > Login as Nusrat (saves the token)  2) Zones > List zones (saves the zone ids)  3) Fares > Estimate  4) Rides > Book a ride.\nLogging in as someone else replaces the saved token, so you switch identity by running another login.\nMoney is always integer paisa (6400 = 64.00 taka). Demo password for everyone: tesla1234.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "rideId", "value": "", "type": "string" },
    { "key": "poolId", "value": "", "type": "string" },
    { "key": "zone_Banani", "value": "", "type": "string" },
    { "key": "zone_Gulshan_1", "value": "", "type": "string" },
    { "key": "zone_Gulshan_2", "value": "", "type": "string" },
    { "key": "zone_Mohakhali", "value": "", "type": "string" },
    { "key": "zone_Farmgate", "value": "", "type": "string" },
    { "key": "zone_Dhanmondi", "value": "", "type": "string" },
    { "key": "zone_Mirpur", "value": "", "type": "string" },
    { "key": "zone_Uttara", "value": "", "type": "string" },
    { "key": "zone_Bashundhara", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and db connected', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().db).to.eql('connected');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Nusrat (passenger)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01711000002\",\n  \"password\": \"tesla1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and role PASSENGER', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('PASSENGER');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Rafiq (passenger)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01711000003\",\n  \"password\": \"tesla1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and role PASSENGER', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('PASSENGER');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Shirin (passenger)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01711000004\",\n  \"password\": \"tesla1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and role PASSENGER', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('PASSENGER');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Jashim (driver)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01711000001\",\n  \"password\": \"tesla1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and role DRIVER', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('DRIVER');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a new passenger",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tania Rahman\",\n  \"phone\": \"01811000009\",\n  \"password\": \"tesla1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 the first time, 409 PHONE_TAKEN if you send it again",
                  "pm.test('201 (new) or 409 (already registered)', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user (GET /me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the logged-in user', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user).to.have.property('role');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Zones",
      "item": [
        {
          "name": "List zones (saves all zone ids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/zones", "host": ["{{baseUrl}}"], "path": ["zones"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and zones returned', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().zones.length).to.be.above(0);",
                  "});",
                  "// saves zone_Banani, zone_Gulshan_1, zone_Mohakhali ... for the other requests",
                  "pm.response.json().zones.forEach(z =>",
                  "  pm.collectionVariables.set('zone_' + z.name.replace(/ /g, '_'), z.id));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fares",
      "item": [
        {
          "name": "Estimate: Nusrat (Banani to Mohakhali)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupZoneId\": \"{{zone_Banani}}\",\n  \"destZoneId\": \"{{zone_Mohakhali}}\",\n  \"seats\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/fares/estimate", "host": ["{{baseUrl}}"], "path": ["fares", "estimate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Nusrat: 2500 m, solo 8000, pooled 6400', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.distanceM).to.eql(2500);",
                  "  pm.expect(b.solo).to.eql(8000);",
                  "  pm.expect(b.pooled).to.eql(6400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Estimate: Rafiq (Banani to Gulshan 1)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupZoneId\": \"{{zone_Banani}}\",\n  \"destZoneId\": \"{{zone_Gulshan_1}}\",\n  \"seats\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/fares/estimate", "host": ["{{baseUrl}}"], "path": ["fares", "estimate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rafiq: 3000 m, solo 9000, pooled 7200', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.distanceM).to.eql(3000);",
                  "  pm.expect(b.solo).to.eql(9000);",
                  "  pm.expect(b.pooled).to.eql(7200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Rides",
      "item": [
        {
          "name": "Book a ride (Banani to Mohakhali)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupZoneId\": \"{{zone_Banani}}\",\n  \"destZoneId\": \"{{zone_Mohakhali}}\",\n  \"seats\": 1,\n  \"allowPool\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/rides", "host": ["{{baseUrl}}"], "path": ["rides"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 the first time. 409 ACTIVE_RIDE_EXISTS if you already have an active ride.",
                  "pm.test('201 (booked) or 409 (already have an active ride)', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('rideId', pm.response.json().ride.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My active ride",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rides?scope=active",
              "host": ["{{baseUrl}}"],
              "path": ["rides"],
              "query": [{ "key": "scope", "value": "active" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and a rides list', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().rides).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My ride history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rides?scope=history",
              "host": ["{{baseUrl}}"],
              "path": ["rides"],
              "query": [{ "key": "scope", "value": "history" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and a rides list', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().rides).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one ride (uses the saved rideId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/rides/{{rideId}}", "host": ["{{baseUrl}}"], "path": ["rides", "{{rideId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200 for your own ride. 404 if it belongs to someone else (log in as Rafiq to see it).",
                  "pm.test('200 (yours) or 404 (not yours)', () => {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Driver",
      "item": [
        {
          "name": "Go online (Banani)",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"online\": true,\n  \"zoneId\": \"{{zone_Banani}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/driver/availability", "host": ["{{baseUrl}}"], "path": ["driver", "availability"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Log in as Jashim first (Auth folder)",
                  "pm.test('200 and online in Banani', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().availability.isOnline).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Go offline",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"online\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/driver/availability", "host": ["{{baseUrl}}"], "path": ["driver", "availability"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200 if you have no active trip, 409 ACTIVE_POOL_EXISTS if you do",
                  "pm.test('200 (offline) or 409 (finish your trip first)', () => {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/driver/availability", "host": ["{{baseUrl}}"], "path": ["driver", "availability"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the vehicle and online status', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().availability).to.have.property('isOnline');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Requests feed (waiting rides in my zone)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/driver/requests", "host": ["{{baseUrl}}"], "path": ["driver", "requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 409 DRIVER_OFFLINE if you have not gone online yet",
                  "pm.test('200 (feed) or 409 (go online first)', () => {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().requests.length) {",
                  "  pm.collectionVariables.set('rideId', pm.response.json().requests[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept a ride (uses the saved rideId)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/driver/requests/{{rideId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["driver", "requests", "{{rideId}}", "accept"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200 the ride is now your trip. 409 if someone got there first, or it is not in your zone.",
                  "pm.test('200 (accepted) or 409 (no longer available)', () => {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) pm.collectionVariables.set('poolId', pm.response.json().pool.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My trip history",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/driver/history", "host": ["{{baseUrl}}"], "path": ["driver", "history"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and a list of finished trips', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().pools).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trip (driver runs their current pool)",
      "item": [
        {
          "name": "Current trip",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/driver/pool/current", "host": ["{{baseUrl}}"], "path": ["driver", "pool", "current"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// pool is null when you have no active trip: an empty state, not an error",
                  "pm.test('200, pool or null', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('pool');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Arrive at pickup",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/driver/pool/arrive", "host": ["{{baseUrl}}"], "path": ["driver", "pool", "arrive"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and status DRIVER_ARRIVED, or 409/404 if there is no open trip', () => {",
                  "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "  if (pm.response.code === 200) pm.expect(pm.response.json().pool.status).to.eql('DRIVER_ARRIVED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Start trip (locks the final fares)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/driver/pool/start", "host": ["{{baseUrl}}"], "path": ["driver", "pool", "start"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and status STARTED, or 409/404 if arrive has not happened yet', () => {",
                  "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "  if (pm.response.code === 200) pm.expect(pm.response.json().pool.status).to.eql('STARTED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Drop off a passenger (uses the saved rideId)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/driver/pool/requests/{{rideId}}/dropoff",
              "host": ["{{baseUrl}}"],
              "path": ["driver", "pool", "requests", "{{rideId}}", "dropoff"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 409 if the trip has not STARTED yet, or this passenger was already dropped off",
                  "pm.test('200 (dropped off) or 409/404', () => {",
                  "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark a passenger as no-show (uses the saved rideId)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/driver/pool/requests/{{rideId}}/no-show",
              "host": ["{{baseUrl}}"],
              "path": ["driver", "pool", "requests", "{{rideId}}", "no-show"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only valid after 'Arrive at pickup' and before 'Start trip'",
                  "pm.test('200 (marked) or 409/404', () => {",
                  "  pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel trip (before start; passengers go back to waiting)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/driver/pool/cancel", "host": ["{{baseUrl}}"], "path": ["driver", "pool", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 409 INVALID_TRANSITION once the trip has STARTED",
                  "pm.test('200 (cancelled) or 409 (already started)', () => {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Failure cases (each should be rejected)",
      "item": [
        {
          "name": "Login with a wrong password (expect 401)",
