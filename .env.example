# Copy this file to .env and adjust values. Never commit the real .env.
# Read by both docker-compose (postgres service) and the api (via dotenv).

# --- Database ---
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=tesla_pool
POSTGRES_PORT=5432
# Used by the api / Prisma. Matches the values above; host is "localhost"
# when the api runs on your machine, or "db" when it later runs inside compose.
DATABASE_URL=postgresql://tesla:tesla@localhost:5432/tesla_pool

# --- API ---
NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Secret used to sign JWTs. Replace with a long random string in your real .env
# (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
